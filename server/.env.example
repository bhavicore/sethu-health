# Optional. The demo runs fully end-to-end without any of these — see the
# root README's "What's real vs. mocked" section for what each key enables.

# Sarvam AI (Task 2.1 STT, Task 2.3 TTS). Without it: doctors type dictation
# directly, and no WhatsApp voice notes are generated.
SARVAM_API_KEY=

# Google Gemini (Task 2.2 patient-advice wording, Task 4.2 indent notes).
# Without it: patient advice is shown in English unchanged, and indent
# justifications use a plain arithmetic-based template sentence.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Meta WhatsApp Cloud API. Without these: same-day messages are queued in the
# whatsapp_outbox table (visible via the audit trail) but never actually sent.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Override the SQLite file location or server port if needed.
# SETHU_DB_PATH=./sethu.db
# PORT=4000
